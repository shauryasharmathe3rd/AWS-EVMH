# ==========================================
# Tript-Dhara Environment Configuration
# ==========================================

# City info (Default: Ghaziabad, NCR, India based on given coordinates)
CITY_NAME=Ghaziabad
CITY_LAT=28.6345839
CITY_LON=77.4477459

# Demo & Operations flags
DEMO_MODE=true
ALLOW_PUBLIC_STATUS_CHANGES=true
ENABLE_IMPORT_API=false

# Database Configuration
POSTGRES_DB=tript_dhara
POSTGRES_USER=tript_user
POSTGRES_PASSWORD=tript_secure_pass
DATABASE_URL=postgresql://tript_user:tript_secure_pass@db:5432/tript_dhara

# Networking / Security
CORS_ORIGINS=*
GATEWAY_PORT=8080

# External Data APIs
OPEN_METEO_BASE_URL=https://api.open-meteo.com/v1
DATA_GOV_IN_API_KEY=
GEE_SERVICE_ACCOUNT=
GEE_KEY_FILE=

# Strands Agents SDK / Operator Briefing (AWS Open Source)
ENABLE_STRANDS_BRIEFING=true
MODEL_PROVIDER=
MODEL_ID=
MODEL_API_KEY=

# Storage
STORAGE_ADAPTER=local
PHOTO_MAX_MB=5
